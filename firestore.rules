rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Runtime knobs (AI cap, copy prompt). App reads only.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /eventRecords/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /eventOverrides/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /venueOverrides/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /copy/{col}/lines/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /airportCache/{icao} {
      allow read: if true;
      allow write: if false;
    }

    match /roadCache/corridors/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid}/notificationState/{doc} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Emails are doc ids. Get is allowed so sign-in can match a waitlister.
    // List is denied so the cohort cannot be dumped.
    match /waitlist/{email} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
