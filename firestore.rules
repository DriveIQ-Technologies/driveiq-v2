rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email.lower()));
    }

    // Dashboard access. Doc id is the lowercase email. Written from console / script.
    match /adminUsers/{email} {
      allow get: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email.lower();
      allow list, write: if false;
    }

    // Runtime knobs (AI cap, copy prompt). App reads only.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /eventRecords/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /eventsPublished/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /eventsPublishedMeta/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /eventOverrides/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /venueOverrides/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /copy/{col}/lines/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /airportCache/{icao} {
      allow read: if true;
      allow write: if false;
    }

    match /airportCacheDay/{icao} {
      allow read: if true;
      allow write: if false;
    }

    match /railCache/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /roadCorridors/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid}/notificationState/{doc} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /users/{uid}/entitlements/{doc} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /users/{uid}/usageDaily/{day} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /waitlistClaims/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /waitlistTokens/{token} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /waitlist/{email} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /aiCostLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny([
          'tier',
          'entitlement',
          'premiumUntil',
          'waitlistEmail',
          'waitlistClaimedAt',
          'premiumPlan',
          'premiumStatus',
          'premiumSource',
          'premiumTrialEndsAt',
          'premiumExpiresAt',
          'premiumCancelledAt',
        ]);
      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'tier',
          'entitlement',
          'premiumUntil',
          'waitlistEmail',
          'waitlistClaimedAt',
          'premiumPlan',
          'premiumStatus',
          'premiumSource',
          'premiumTrialEndsAt',
          'premiumExpiresAt',
          'premiumCancelledAt',
        ]);
    }

    match /communityReports/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
