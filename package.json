{
  "name": "driveiq",
  "version": "5.2.4",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "vitest run && npm --prefix functions test",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "waitlist:generate": "npm --prefix functions run waitlist:generate --",
    "waitlist:seed": "npm --prefix functions run waitlist:seed --",
    "waitlist:bulk": "npm --prefix functions run waitlist:bulk --",
    "waitlist:self-test": "npm --prefix functions run waitlist:self-test",
    "waitlist:auth": "npm --prefix functions run waitlist:auth",
    "waitlist:verify": "npm --prefix functions run waitlist:verify",
    "eas-build-pre-install": "corepack enable"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "^55.0.25",
    "expo-apple-authentication": "^57.0.1",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.15",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "firebase": "^12.4.0",
    "posthog-react-native": "^4.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-purchases": "10.8.1",
    "react-native-purchases-ui": "10.8.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.10",
    "firebase-tools": "^15.27.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "packageManager": "npm@10.9.2"
}
