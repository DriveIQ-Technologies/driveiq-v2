{
  "name": "driveiq-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run",
    "waitlist:generate": "NODE_PATH=./node_modules node ../scripts/seed-waitlist-codes.mjs generate",
    "waitlist:seed": "NODE_PATH=./node_modules node ../scripts/seed-waitlist-codes.mjs seed",
    "waitlist:bulk": "NODE_PATH=./node_modules node ../scripts/seed-waitlist-codes.mjs bulk",
    "waitlist:self-test": "NODE_PATH=./node_modules node ../scripts/seed-waitlist-codes.mjs self-test",
    "waitlist:auth": "NODE_PATH=./node_modules node ../scripts/seed-waitlist-codes.mjs auth",
    "waitlist:verify": "NODE_PATH=./node_modules node ../scripts/seed-waitlist-codes.mjs verify",
    "waitlist:reset": "NODE_PATH=./node_modules node ../scripts/reset-waitlist-claim.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
